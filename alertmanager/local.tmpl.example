{{/*
  Copier dans alertmanager/local/local.tmpl, hors depot (.gitignore), et adapter.
  Ce qui est defini ici remplace la definition du meme nom dans slack.tmpl.
*/}}

{{/* Identifiants des canaux Slack : clic droit sur le canal → Copier le lien, le C… final. */}}
{{ define "canal.alertes" }}C0000000000{{ end }}
{{ define "canal.urgent" }}C0000000001{{ end }}

{{/* Table tache → geste, pour TacheMuette. Une branche par nom passe a `pouls`. */}}
{{ define "geste.tache" -}}
{{ if eq .Labels.tache "sauvegarde" }}lire <dossier>/backup.log, relancer backup.sh
{{- else if eq .Labels.tache "hermes" }}vérifier d'abord que collecte-hermes pulse (sinon c'est le collecteur hermes.py), puis redémarrer la passerelle d'Hermès
{{- else if eq .Labels.tache "collecte-quota" }}le cron de quota.py ne tourne plus : vérifier la crontab, puis lire <log>/quota.log
{{- else if eq .Labels.tache "collecte-hermes" }}le cron de hermes.py ne tourne plus : vérifier la crontab, puis lire <log>/hermes.log
{{- else }}lire le log de la tâche {{ .Labels.tache }}, puis la relancer
{{- end }}
{{- end }}
