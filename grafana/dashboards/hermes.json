    {
      "id": 17,
      "type": "gauge",
      "title": "Quota utilisé, par fenêtre",
      "description": "Part consommée de chaque fenêtre du quota Codex.\n\n⛔ Vide = « mesure absente » : la lecture du quota a échoué ou n'a pas eu lieu. Ce n'est jamais 0 %.",
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "noValue": "mesure absente",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "max by (fenetre) (hermes_quota_percent) and on() (max(hermes_quota_collecte_ok) == 1)",
          "legendFormat": "{{fenetre}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "bargauge",
      "title": "repart dans",
      "description": "Temps restant avant que chaque fenêtre reparte de zéro.\n\n⛔ Vide = « mesure absente » : la lecture du quota a échoué ou n'a pas eu lieu. Ce n'est jamais 0 %.",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text-muted"
          },
          "decimals": 0,
          "noValue": "mesure absente"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": false,
        "valueMode": "text"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "max by (fenetre) (hermes_quota_resets_at) - time() and on() (max(hermes_quota_collecte_ok) == 1)",
          "legendFormat": "{{fenetre}}"
        }
      ]
    },
