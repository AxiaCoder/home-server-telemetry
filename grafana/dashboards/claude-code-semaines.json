          "expr": "100 * (sum(max_over_time({__name__=\"claude_code.cost.usage\", machine=~\"$machine\"}[$__range])) / sum(max_over_time({__name__=\"claude_code.cost.usage\", machine=~\"$machine\"}[$__range] offset 7d)) - 1)"
        }
      ]
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Jour par jour, les deux semaines superposées",
      "description": "La semaine -1 est décalée de 7 jours : chaque barre se lit en face du même jour de la semaine en cours.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "interval": "1d",
          "legendFormat": "en cours",
          "expr": "sum(max_over_time({__name__=\"claude_code.token.usage\", type=\"cacheRead\", machine=~\"$machine\"}[1d]))"
        },
        {
          "refId": "B",
          "interval": "1d",
          "legendFormat": "semaine -1",
          "expr": "sum(max_over_time({__name__=\"claude_code.token.usage\", type=\"cacheRead\", machine=~\"$machine\"}[1d] offset 7d))"
        }
      ]
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Par machine",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{machine}} — en cours",
          "expr": "sum by (machine) (max_over_time({__name__=\"claude_code.token.usage\", type=\"cacheRead\", machine=~\"$machine\"}[$__range]))"
        },
        {
          "refId": "B",
          "instant": true,
          "legendFormat": "{{machine}} — semaine -1",
          "expr": "sum by (machine) (max_over_time({__name__=\"claude_code.token.usage\", type=\"cacheRead\", machine=~\"$machine\"}[$__range] offset 7d))"
        }
      ]
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Principal contre sous-agents",
      "description": "En coût relatif : un sous-agent crée du cache au lieu d'en relire, sa part serait invisible en cacheRead.",
      "gridPos": {
        "h": 8,
        "w": 12,
